{
  "name": "@noux/core",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sync-idl": "cp ../../program/target/idl/noux.json idl/noux.json",
    "build": "tsup",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@anchor-lang/core": "^1.2.1",
    "@solana/web3.js": "1.99.0",
    "bs58": "^6.0.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "8.5.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  },
  "description": "Claim format, PDAs, campaign reader and the program IDL for Noux, a pay-for-performance referral layer for x402 on Solana.",
  "files": [
    "dist",
    "idl",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Emmythefirst/Noux.git",
    "directory": "packages/core"
  },
  "homepage": "https://noux.vercel.app",
  "bugs": {
    "url": "https://github.com/Emmythefirst/Noux/issues"
  },
  "keywords": [
    "solana",
    "x402",
    "referral",
    "anchor"
  ],
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  }
}
