{
  "name": "@noux/gateway",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@anchor-lang/core": "^1.2.1",
    "@noux/core": "workspace:^",
    "@solana/spl-token": "^0.4.0",
    "@solana/web3.js": "1.99.0",
    "@x402/core": "^2.28.0",
    "@x402/express": "^2.28.0",
    "@x402/svm": "^2.28.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "express": "^5.0.0",
    "tsup": "8.5.0",
    "tweetnacl": "^1.0.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  },
  "description": "Express middleware that makes a paid x402 route referral-aware on Solana: buyer-bound claims, per-sale vaults, on-chain split.",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Emmythefirst/Noux.git",
    "directory": "packages/gateway"
  },
  "homepage": "https://noux.vercel.app",
  "bugs": {
    "url": "https://github.com/Emmythefirst/Noux/issues"
  },
  "keywords": [
    "solana",
    "x402",
    "referral",
    "express",
    "middleware"
  ],
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  }
}
